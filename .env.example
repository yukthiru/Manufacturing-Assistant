DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# postgres | mysql | sqlite (sqlite only for quick local tests)
DB_ENGINE=postgres
DB_NAME=manualdb
DB_USER=postgres
DB_PASSWORD=260707
DB_HOST=127.0.0.1
DB_PORT=5432

# Any OpenAI-compatible endpoint. Leave LLM_API_KEY empty to use the offline
# fallback (hashed bag-of-words embeddings + extractive answers).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
# RAG_MIN_SCORE=0.30
